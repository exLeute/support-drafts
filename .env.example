# Without a key the service still calls Anthropic, gets 401 and uses a static draft after a 5-30 s delay.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_RPM=60
WORKER_CONCURRENCY=30
MAX_ATTEMPTS=8

# Base for knowledge-base links inside drafts. Set to the public URL when deployed.
PUBLIC_BASE_URL=http://localhost:8000

# Empty = operator UI and the mock's reply list are open. Set it on any public deployment (HTTP Basic, any username).
OPERATOR_PASSWORD=

# Helpdesk hosts the worker may POST replies to. The service's own host is allowed only for /mock-helpdesk/ paths.
REPLY_URL_HOSTS=helpdesk.example.com

# Mock helpdesk misbehaviour: share of 503 answers and of answers slower than the sender's timeout.
MOCK_FAIL_RATE=0.2
MOCK_SLOW_RATE=0.1
