{
  "permissions": {
    "allow": [
      "Bash(docker compose up:*)",
      "Bash(docker compose run --rm test:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose exec -T db psql:*)",
      "Bash(scripts/e2e.sh)",
      "Bash(curl -s localhost:8000/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(docker compose down -v:*)",
      "Bash(git push --force:*)"
    ]
  }
}
